# Copy to .env and edit before running `docker compose up -d`.

# Port exposed on the host
HOST_PORT=8000

# Admin user (full access)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional read-only viewer account
VIEWER_USER=
VIEWER_PASSWORD=

# Set to "false" to refuse all create/delete/start/stop calls
ALLOW_DESTRUCTIVE=true

# Default shell used when opening an in-browser terminal into a container
EXEC_DEFAULT_SHELL=/bin/sh

# Image used as a sidecar to browse volume contents (must include python3)
BROWSER_IMAGE=python:3-alpine

# HS256 signing key for JWTs. STRONGLY recommended in production: if unset, a
# random secret is generated on startup and any existing tokens are invalidated
# on every restart. Use a long, random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# JWT lifetime in seconds (default: 12 hours).
JWT_TTL_SECONDS=43200
