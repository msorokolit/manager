# Copy to .env and edit before running `docker compose up -d`.

# Port exposed on the host
HOST_PORT=8000

# Admin user (full access)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional read-only viewer account
VIEWER_USER=
VIEWER_PASSWORD=

# Set to "false" to refuse Docker-state-changing calls (volume rm, container kill,
# prune, stack down, etc.). Filesystem mutations inside a volume (chmod, chown,
# edit, mkdir) are gated by the admin role only and remain available.
ALLOW_DESTRUCTIVE=true

# ---- Structured logging (pino) + audit log ----
# pino level: trace / debug / info / warn / error / fatal / silent.
# LOG_LEVEL=info
# Pipe through pino-pretty for human-readable colour output (dev only).
# LOG_PRETTY=false

# Audit log: append-only JSONL of every mutating API request.
# AUDIT_ENABLED=true
# AUDIT_FILE=/data/audit.log
# Size-based in-process rotation. Set to 0 if your log shipper / logrotate
# handles rotation externally.
# AUDIT_MAX_BYTES=10485760
# AUDIT_ROTATE_KEEP=5

# ---- Sessions (server-side session store + revocation) ----
# Disk file that backs the in-memory session store so a restart doesn't
# sign every user out. Mode 0600 on every write.
# SESSIONS_FILE=/data/sessions.json
# How often dirty sessions are flushed to disk (ms). Higher = less I/O,
# smaller "sessions lost on crash" window when lower.
# SESSIONS_PERSIST_INTERVAL_MS=30000
# Cap concurrent sessions per user (0 = unlimited). Set to 1 for
# environments that mandate single-session-per-principal.
# SESSIONS_MAX_PER_USER=0

# Default shell used when opening an in-browser terminal into a container
EXEC_DEFAULT_SHELL=/bin/sh

# Image used by the volume browser (must include python3). One short-lived
# container per browse operation runs from this image with the volume
# mounted at /target. The image is pre-pulled at server startup so the
# first browse doesn't pay the pull cost.
BROWSER_IMAGE=python:3-alpine

# Escape hatch for nested-VM / sandboxed runners whose root cgroup is in
# "domain threaded" mode (runc refuses Memory/NanoCpus/PidsLimit there).
# Production hosts never need this and should leave it unset. CapDrop:ALL
# stays applied regardless.
# VOLUME_BROWSER_NO_LIMITS=true

# HS256 signing key for JWTs. STRONGLY recommended in production: if unset, a
# random secret is generated on startup and any existing tokens are invalidated
# on every restart. Use a long, random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# JWT lifetime in seconds (default: 12 hours).
JWT_TTL_SECONDS=43200

# CORS origin allow-list (comma-separated). Leave empty for same-origin only.
# Example: CORS_ORIGINS=https://manager.example.com,https://ops.example.com
CORS_ORIGINS=

# Set to "true" to disable Helmet entirely (NOT recommended; useful for
# debugging only). Set CSP_DISABLED=true to keep most security headers but
# drop the Content-Security-Policy header.
HELMET_DISABLED=false
CSP_DISABLED=false

# If you fork the SPA and add another CDN, append to these comma-separated
# allow-lists instead of disabling the CSP entirely.
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_STYLE_SRC=
CSP_EXTRA_CONNECT_SRC=
